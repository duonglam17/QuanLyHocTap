@startuml
title US-17 & US-18: Tao buoi hoc (Kiem tra trung gio) & Xem thoi khoa bieu (Chong IDOR)
autonumber
actor GV as "Giang vien"
actor SV as "Sinh vien"
participant FE as "Frontend SPA"
participant MW as "Auth Middleware"
participant SC as "ScheduleController"
participant SS as "ScheduleService"
participant SR as "ScheduleRepository"
database DB as "MySQL DB"

== US-17: Giang vien tao buoi hoc moi (Kiem tra trung gio BR-19, EC-23) ==
GV -> FE : Nhap tieu de, ngay "2026-11-10", gio 08:00 - 11:30, phong "B302" -> Bam "Luu"
FE -> MW : POST /api/courses/{id}/schedules { title, date, startTime, endTime, roomOrLink }
MW -> MW : Verify role == 'GIANG_VIEN'
MW -> SC : Chuyen tiep (gvId = req.user.id)
SC -> SS : createSchedule(courseId, gvId, scheduleData)

alt start_time >= end_time
    SS --> SC : Error: InvalidTimeRange
    SC --> FE : 400 Bad Request { message: "Gio ket thuc phai sau gio bat dau" }
    FE --> GV : Bao loi thoi gian
else Thoi gian co ban hop le
    SS -> SR : checkScheduleConflict(courseId, date, startTime, endTime)
    SR -> DB : SELECT id FROM schedules WHERE course_id = ? AND date = ? AND status != 'CANCELLED' AND ((start_time < ? AND end_time > ?) OR (start_time < ? AND end_time > ?))
    DB --> SR : Conflict records (Neu co)

    alt Phat hien trung gio voi buoi hoc da co (EC-23)
        SS --> SC : Error: ScheduleConflict
        SC --> FE : 409 Conflict { message: "Khung gio bi trung voi buoi hoc da ton tai tren he thong" }
        FE --> GV : Bao loi xung dot lich hoc
    else Khong bi trung lich
        SS -> SR : insertSchedule(courseId, title, date, startTime, endTime, roomOrLink)
        SR -> DB : INSERT INTO schedules (...) VALUES (...)
        DB --> SR : schedule_id
        SS --> SC : Schedule object
        SC --> FE : 201 Created { schedule }
        FE --> GV : Hien thi buoi hoc vao lich hoc cua lop
    end
end

== US-18: Sinh vien xem thoi khoa bieu khoa hoc (Chong IDOR BR-20) ==
SV -> FE : Vao muc "Lich hoc" cua khoa hoc INT3101
FE -> MW : GET /api/courses/{id}/schedules
MW -> MW : Verify JWT sinh vien (studentId = req.user.id)
MW -> SC : Chuyen tiep
SC -> SS : getCourseSchedules(courseId, studentId)
SS -> SR : checkStudentEnrolled(courseId, studentId)
SR -> DB : SELECT id FROM enrollments WHERE course_id = ? AND student_id = ?

alt Sinh vien chua ghi danh vao khoa hoc (Chong IDOR)
    DB --> SR : Null
    SS --> SC : Error: Forbidden
    SC --> FE : 403 Forbidden { message: "Ban can ghi danh khoa hoc de xem thoi khoa bieu chi tiet" }
    FE --> SV : Bao loi khong co quyen
else Sinh vien da ghi danh
    DB --> SR : Enrolled = TRUE
    SS -> SR : getSchedulesList(courseId)
    SR -> DB : SELECT * FROM schedules WHERE course_id = ? AND status != 'CANCELLED' ORDER BY date ASC, start_time ASC
    DB --> SR : List of schedules
    SS --> SC : schedules
    SC --> FE : 200 OK { schedules }
    FE --> SV : Hien thi danh sach cac buoi hoc & lam noi bat buoi hoc gan nhat
end
@enduml

