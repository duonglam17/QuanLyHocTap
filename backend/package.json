{
  "name": "lms-mini-backend",
  "version": "1.0.0",
  "description": "Backend scaffold for LMS Mini - Modular Monolith Architecture",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "nodemon src/server.js",
    "lint": "eslint src/ tests/",
    "format": "prettier --write \"src/**/*.js\"",
    "test": "node --test tests/**/*.test.js",
    "deps:check": "depcruise --config .dependency-cruiser.js src"
  },
  "keywords": [
    "lms",
    "modular-monolith",
    "express",
    "clean-architecture"
  ],
  "author": "LMS Mini Team",
  "license": "ISC",
  "dependencies": {
    "bcrypt": "^6.0.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.0",
    "express-rate-limit": "^8.7.1",
    "file-type": "^16.5.4",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "multer": "^2.4.0",
    "mysql2": "^3.11.3",
    "node-cron": "^4.6.0",
    "sanitize-html": "^2.18.1",
    "swagger-ui-express": "^5.0.1",
    "yaml": "^2.9.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "dependency-cruiser": "^16.4.0",
    "eslint": "^8.57.0",
    "nodemon": "^3.1.7",
    "prettier": "^3.3.3",
    "supertest": "^7.3.1"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
