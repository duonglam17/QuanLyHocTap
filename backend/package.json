{
  "name": "lms-mini-backend",
  "version": "1.0.0",
  "description": "Backend scaffold for LMS Mini - Modular Monolith Architecture",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "nodemon src/server.js",
    "lint": "eslint src/",
    "format": "prettier --write \"src/**/*.js\"",
    "test": "node --test tests/**/*.test.js",
    "deps:check": "depcruise --config .dependency-cruiser.js src"
  },
  "keywords": [
    "lms",
    "modular-monolith",
    "express",
    "clean-architecture"
  ],
  "author": "LMS Mini Team",
  "license": "ISC",
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.0",
    "mysql2": "^3.11.3"
  },
  "devDependencies": {
    "dependency-cruiser": "^16.4.0",
    "eslint": "^8.57.0",
    "nodemon": "^3.1.7",
    "prettier": "^3.3.3"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}

