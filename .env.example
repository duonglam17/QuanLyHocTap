# =============================================================================
# LMS MINI - ENVIRONMENT VARIABLES EXAMPLE
# Copy file này thành .env trước khi khởi chạy ứng dụng
# =============================================================================

# Server Cấu hình
PORT=5000
NODE_ENV=development
TZ=Asia/Ho_Chi_Minh

# Cơ sở dữ liệu MySQL
DB_HOST=localhost
DB_PORT=3306
DB_USER=lms_user
DB_PASSWORD=local-development-only
DB_NAME=lms_mini_db
DB_CONNECTION_LIMIT=10
MYSQL_ROOT_PASSWORD=local-root-password

# Xác thực JWT & Bảo mật (Thay thế bằng chuỗi ngẫu nhiên an toàn trong môi trường thực tế)
JWT_SECRET=local-development-secret-change-before-deployment
JWT_EXPIRES_IN=15m
REFRESH_TOKEN_EXPIRES_IN=7d

# Lưu trữ tệp tin (Đường dẫn nằm ngoài Web Root)
UPLOAD_DIR=./uploads

# CORS Origin (Cho phép Frontend kết nối)
CORS_ORIGIN=http://localhost:3000,http://localhost:5173
